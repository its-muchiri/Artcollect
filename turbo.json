{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build", "^generate"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "generated/**"],
      "env": [
        "DATABASE_URL",
        "DATABASE_URL_UNPOOLED",
        "AUTH_SECRET",
        "NEXT_PUBLIC_APP_URL",
        "FLW_SECRET_KEY",
        "FLW_SECRET_HASH"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build", "^generate"]
    },
    "test": {
      "cache": false
    },
    "generate": {
      "cache": false,
      "outputs": ["generated/**"]
    }
  }
}
