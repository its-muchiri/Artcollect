DATABASE_URL="postgresql://user:password@localhost:5432/artcollect?schema=public"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# https://dashboard.flutterwave.com/settings/apis — use TEST keys until go-live.
FLW_SECRET_KEY=""
# Dashboard > Settings > Webhooks > Secret Hash — must match exactly.
FLW_SECRET_HASH=""

# The app's own canonical URL — used to build the redirect_url Flutterwave
# sends the buyer back to, and the checkout link ArtCollect's editorial
# event pages link to (see src/lib/events.ts).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
